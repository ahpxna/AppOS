FROM python:3.12-slim@sha256:2c941e860699f878900b0edc2403613c234d4b32eda3cc9fa7036991a2a63c4a

WORKDIR /app

# This worker only needs PostgreSQL transport; source code is mounted
# read-only by Compose so it cannot silently rewrite the project.
COPY constraints-v1.txt /tmp/jobos-constraints-v1.txt
RUN pip install --no-cache-dir -c /tmp/jobos-constraints-v1.txt "psycopg[binary]>=3.2.3,<4"

CMD ["python", "services/discovery/market_demand_intelligence_v1.py", "process", "--apply"]
