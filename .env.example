# =========================================================
# job-apply-os -- environment template
#
# Copy this file to `.env` in the repo root, then fill in the values
# marked CHANGE ME. `.env` itself is git-ignored -- never commit it.
#
#   cp .env.example .env
#
# Everything below is read either by docker-compose.yml /
# docker-compose.openclaw.yml, or by the Python services under services/*
# (each one reads with os.getenv("VAR", "<default shown here>"), so any
# var you don't set falls back to the default already baked into the code
# -- you only strictly need to fill in the CHANGE ME ones).
# =========================================================


# ---------------------------------------------------------
# 1. Postgres (docker-compose.yml)
# ---------------------------------------------------------
POSTGRES_USER=jobos
POSTGRES_PASSWORD=CHANGE_ME_local_dev_password
# Host-side port Postgres is published on (container always uses 5432
# internally). Services connect via JOBOS_DB_PORT below, which must match.
POSTGRES_HOST_PORT=5433


# ---------------------------------------------------------
# 2. n8n (docker-compose.yml) -- workflow/orchestration UI
# ---------------------------------------------------------
# Any random 32+ char string. Used to encrypt n8n's stored credentials.
N8N_ENCRYPTION_KEY=CHANGE_ME_random_32_char_string
N8N_USER_MANAGEMENT_DISABLED=false
N8N_PORT=5678


# ---------------------------------------------------------
# 3. Python services -- database connection
#    (must match section 1 above; only needed if you run services
#    outside Docker, e.g. `python services/orchestrator/orchestrator_v1.py`)
# ---------------------------------------------------------
JOBOS_DB_HOST=127.0.0.1
JOBOS_DB_PORT=5433
JOBOS_DB_NAME=job_apply_os
JOBOS_DB_USER=jobos
JOBOS_DB_PASSWORD=CHANGE_ME_local_dev_password


# ---------------------------------------------------------
# 4. Ollama (local LLM runtime -- no API key needed, must be installed
#    and running separately: https://ollama.com/download)
#    Different scripts historically used different var names for the
#    same thing; set all three to be safe, they all default to this URL.
# ---------------------------------------------------------
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434

# Models this pipeline expects to be pulled locally via `ollama pull <name>`:
#   ollama pull qwen3:8b
#   ollama pull qwen3:4b
#   ollama pull deepseek-r1:14b
#   ollama pull nomic-embed-text
# (Override which model each stage uses -- optional, defaults shown.)
JOBOS_DOCGEN_MODEL=qwen3:8b
JOBOS_VERIFIER_MODEL=qwen3:8b
JOBOS_REPLY_MODEL=qwen3:8b
JOBOS_INTERVIEW_PREP_MODEL=qwen3:8b
PROFILE_ASSET_SYNTHESIZER_MODEL=qwen3:8b
PROFILE_DOCUMENT_MAPPER_MODEL=qwen3:8b
PROFILE_EVIDENCE_UNIT_MODEL=qwen3:8b
STRUCTURED_ASSET_SYNTH_MODEL=qwen3:8b
STRUCTURED_EVIDENCE_UNIT_MODEL=qwen3:8b
PROFILE_ASSET_AUDITOR_MODEL=deepseek-r1:14b
PROFILE_EMBED_MODEL=nomic-embed-text
PROFILE_EMBED_DIM=768


# ---------------------------------------------------------
# 5. OpenClaw (browser automation runtime -- separate install, see
#    docs/openclaw.md and scripts/openclaw_bootstrap.py)
# ---------------------------------------------------------
# Used by scripts that shell out to the `openclaw` CLI directly.
OPENCLAW_BIN=openclaw
# Base URL of the OpenClaw gateway once it's running (native or Docker).
OPENCLAW_BASE_URL=http://127.0.0.1:18789
# Named agent profiles OpenClaw should use for each task (must exist in
# your ~/.openclaw config -- see bootstrap/openclaw/openclaw.template.json).
OPENCLAW_AGENT_RESEARCH=main
OPENCLAW_AGENT_BROWSE=main
OPENCLAW_AGENT_RESUME=resume
OPENCLAW_AGENT_COVER=cover_letter

# --- Only needed if you use the Docker fallback
#     (docker compose -f docker-compose.yml -f docker-compose.openclaw.yml up -d) ---
# Any random string -- this becomes the token you paste into the OpenClaw
# gateway UI at http://127.0.0.1:18789 the first time you open it.
OPENCLAW_GATEWAY_TOKEN=CHANGE_ME_random_token
# Password for the noVNC desktop used to log into sites by hand once.
BROWSER_VNC_PASSWORD=CHANGE_ME_random_password
# Which OpenClaw image to pull. Leave commented to use the default.
# OPENCLAW_IMAGE=khal3d/openclaw:latest


# ---------------------------------------------------------
# 6. OpenClaw secrets (NOT read from this .env file -- OpenClaw reads its
#    own secrets file instead: bootstrap/openclaw/secrets.local.json,
#    created by copying bootstrap/openclaw/secrets.example.json).
#    Listed here so you know every key OpenClaw itself needs before you
#    run `python scripts/openclaw_bootstrap.py bootstrap`.
# ---------------------------------------------------------
#   GATEWAY_TOKEN            -- same random token as OPENCLAW_GATEWAY_TOKEN above
#   HOOKS_TOKEN               -- random token, protects OpenClaw's webhook endpoint
#   TELEGRAM_BOT_TOKEN        -- from @BotFather on Telegram, if you want Telegram control
#   TELEGRAM_ALLOW_FROM       -- your Telegram numeric user ID(s), as a JSON array
#   GMAIL_ACCOUNT              -- Gmail address OpenClaw should watch, if using Gmail push
#   GMAIL_TOPIC                -- Google Cloud Pub/Sub topic (Gmail watch integration)
#   GMAIL_SUBSCRIPTION         -- Google Cloud Pub/Sub subscription name
#   GMAIL_PUSH_TOKEN           -- verification token for the Gmail push webhook
#   GOOGLE_WEBSEARCH_API_KEY   -- Google Custom Search / Programmable Search API key,
#                                 if OpenClaw's research agent uses live web search
#
# None of these are required to run the core pipeline (job intake, fit
# scoring, document generation, autofill draft) -- only needed if you turn
# on OpenClaw's Telegram control channel, Gmail watch, or web search tool.


# ---------------------------------------------------------
# 7. Tuning knobs (all optional -- sane defaults already in code)
# ---------------------------------------------------------
# JOBOS_BROWSER_LEASE_SECONDS=600
# JOBOS_BROWSER_PROFILE=remote
# JOBOS_FACT_EXTRACT_LIMIT=
# JOBOS_FACT_MIN_TOKENS=
# JOBOS_FACT_SLEEP_SECONDS=
# JOBOS_RESEARCH_TTL_DAYS=
# JOBOS_PROJECT_ROOT=
# JOBOS_PROFILE_RAW_DIR=
# JOBOS_PROFILE_PARSED_DIR=
# JOBOS_PROFILE_OCR_DIR=
