# =========================================================
# job-apply-os -- environment template
#
# Copy this file to `.env` in the repo root, then fill in the values
# marked CHANGE ME. `.env` itself is git-ignored -- never commit it.
#
#   cp .env.example .env
#
# Docker Compose reads this file directly. Every JobOS executable loads this
# safe KEY=VALUE configuration through services/common/config.py; do not
# `source .env` in a shell. Values marked CHANGE_ME must be replaced.
# =========================================================


# ---------------------------------------------------------
# 1. Postgres (docker-compose.yml)
# ---------------------------------------------------------
POSTGRES_USER=jobos
POSTGRES_PASSWORD=CHANGE_ME_local_dev_password
# Host-side port Postgres is published on (container always uses 5432
# internally). Services connect via JOBOS_DB_PORT below, which must match.
POSTGRES_HOST_PORT=5433


# ---------------------------------------------------------
# 2. n8n (docker-compose.yml) -- workflow/orchestration UI
# ---------------------------------------------------------
# Any random 32+ char string. Used to encrypt n8n's stored credentials.
N8N_ENCRYPTION_KEY=CHANGE_ME_random_32_char_string
N8N_USER_MANAGEMENT_DISABLED=false
N8N_PORT=5678
# Pin optional container images; do not use floating :latest in release deployments.
# Optional legacy n8n image. Override only with an immutable tag@sha256 reference.
JOBOS_N8N_IMAGE=n8nio/n8n:2.32.6@sha256:5f7856f4fc7cd935230f7596e39fdb3d5eda0e379c5b40b699b9c0eb35ebd0bf


# ---------------------------------------------------------
# 3. Python services -- database connection
#    (must match section 1 above; only needed if you run services
#    outside Docker, e.g. `python services/orchestrator/orchestrator_v1.py`)
# ---------------------------------------------------------
JOBOS_DB_HOST=127.0.0.1
JOBOS_DB_PORT=5433
JOBOS_DB_NAME=job_apply_os
JOBOS_DB_USER=jobos
JOBOS_DB_PASSWORD=CHANGE_ME_local_dev_password


# ---------------------------------------------------------
# 4. Shared LLM gateway. Every Python LLM/embedding call goes through
#    services/common/llm_gateway.py. Pick Ollama (default) or any
#    OpenAI-compatible token API globally, or per role. Never commit API keys.
# ---------------------------------------------------------
# Default local option (no API key; install separately: https://ollama.com/download).
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Required only for docker-compose.ollama-gpu.yml; use an immutable tag@sha256 reference.
JOBOS_OLLAMA_IMAGE=ollama/ollama:0.32.14@sha256:9d30908e41144b1f1da89b9d8e33c07e4aeb43ff41a8660241b1686e2cc330ad
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
JOBOS_LLM_BACKEND=ollama
# If this Ubuntu machine is only a client and the GPU Ollama instance lives on
# a Windows/Linux workstation, create an SSH tunnel first:
#   ssh -N -L 11434:127.0.0.1:11434 <user>@<gpu-workstation>
# Keep the three URLs above on 127.0.0.1. Do not expose unauthenticated Ollama
# directly to a LAN/Internet address. See docs/ubuntu_gpu.md.

# API option: uncomment all three to switch every Python LLM call to an
# OpenAI-compatible endpoint. ``openai`` is the default URL shape. Use a
# provider/model that supports embeddings as well if the embed role uses API.
# JOBOS_LLM_BACKEND=api
# JOBOS_LLM_API_STYLE=openai
# JOBOS_LLM_API_BASE=https://your-provider.example/v1
# JOBOS_LLM_API_KEY=CHANGE_ME_keep_only_in_untracked_env
# JOBOS_LLM_API_MODEL=provider-chat-model
# Token API bases must use HTTPS unless loopback-local and must not contain
# embedded credentials, query parameters, or fragments. Compatible complete
# roots such as https://api.groq.com/openai/v1 and
# https://generativelanguage.googleapis.com/v1beta/openai are accepted as-is.
# A single role can differ from the global choice, for example:
# JOBOS_DOCGEN_LLM_BACKEND=api
# JOBOS_DOCGEN_LLM_API_BASE=https://your-provider.example/v1
# JOBOS_DOCGEN_LLM_API_KEY=CHANGE_ME_keep_only_in_untracked_env
# JOBOS_DOCGEN_API_MODEL=provider-writing-model
# Valid roles: docgen, verifier, reply, interview_prep, job_fit,
# market_intelligence,
# profile_asset_synthesizer, profile_asset_auditor, profile_document_mapper,
# profile_evidence_unit, structured_evidence_unit, structured_asset_synth,
# legacy_local_llm, embed. Role names become upper snake case in env vars.
#
# Suggested mixed-provider layout (keep the keys in this untracked .env):
# - DeepSeek for economical analysis/coordination roles. Its official
#   OpenAI-compatible base URL does NOT include /v1, so set style=deepseek.
# JOBOS_JOB_FIT_LLM_BACKEND=api
# JOBOS_JOB_FIT_LLM_API_STYLE=deepseek
# JOBOS_JOB_FIT_LLM_API_BASE=https://api.deepseek.com
# JOBOS_JOB_FIT_LLM_API_KEY=CHANGE_ME_deepseek_key
# JOBOS_JOB_FIT_API_MODEL=deepseek-v4-flash
#
# - OpenAI Platform API for high-stakes document writing/verification and
#   embeddings. A ChatGPT subscription and an OpenAI Platform API key are
#   separate billing/auth paths; use a Platform key here.
# JOBOS_DOCGEN_LLM_BACKEND=api
# JOBOS_DOCGEN_LLM_API_STYLE=openai
# JOBOS_DOCGEN_LLM_API_BASE=https://api.openai.com/v1
# JOBOS_DOCGEN_LLM_API_KEY=CHANGE_ME_openai_key
# JOBOS_DOCGEN_API_MODEL=YOUR_OPENAI_TEXT_MODEL
# JOBOS_VERIFIER_LLM_BACKEND=api
# JOBOS_VERIFIER_LLM_API_STYLE=openai
# JOBOS_VERIFIER_LLM_API_BASE=https://api.openai.com/v1
# JOBOS_VERIFIER_LLM_API_KEY=CHANGE_ME_openai_key
# JOBOS_VERIFIER_API_MODEL=YOUR_OPENAI_TEXT_MODEL
# JOBOS_EMBED_LLM_BACKEND=api
# JOBOS_EMBED_LLM_API_STYLE=openai
# JOBOS_EMBED_LLM_API_BASE=https://api.openai.com/v1
# JOBOS_EMBED_LLM_API_KEY=CHANGE_ME_openai_key
# JOBOS_EMBED_API_MODEL=text-embedding-3-small

# Models this pipeline expects to be pulled locally via `ollama pull <name>`:
#   ollama pull qwen3:8b
#   ollama pull qwen3:4b
#   ollama pull deepseek-r1:14b
#   ollama pull nomic-embed-text
#
# All model selection now goes through ONE file: services/common/model_config.py
# It is the single declared place every script reads its model name from --
# nothing is hard-coded per-file anymore. Two ways to switch models:
#
#   Option A (recommended -- machine-wide switch, e.g. on a beefier box):
#   set these 4 vars and every stage that hasn't been overridden below follows them.
JOBOS_DEFAULT_CHAT_MODEL=qwen3:8b
JOBOS_DEFAULT_AUDIT_MODEL=deepseek-r1:14b
JOBOS_DEFAULT_EMBED_MODEL=nomic-embed-text
JOBOS_DEFAULT_LEGACY_LOCAL_MODEL=llama3.2:3b
#
#   Example for a machine running gemma2:27b + deepseek-r1:32b instead:
#     JOBOS_DEFAULT_CHAT_MODEL=gemma2:27b
#     JOBOS_DEFAULT_AUDIT_MODEL=deepseek-r1:32b
#   (remember to `ollama pull` each model name on that machine first --
#   Ollama models are per-machine, pulling on one box doesn't pull on another.)
#
#   Option B (fine-grained -- override a single stage only, on top of the
#   defaults above). Leave commented out unless you need a stage to use a
#   different model than everything else.
# JOBOS_DOCGEN_MODEL=qwen3:8b
# JOBOS_VERIFIER_MODEL=qwen3:8b
# JOBOS_REPLY_MODEL=qwen3:8b
# JOBOS_INTERVIEW_PREP_MODEL=qwen3:8b
# JOBOS_FIT_MODEL=qwen3:8b
# JOBOS_MARKET_INTELLIGENCE_MODEL=qwen3:8b
# The optional Docker worker is profile-gated. With an API configured above:
# docker compose --profile market-intelligence up -d --build market-intelligence-worker
JOBOS_MARKET_WORKER_POLL_SECONDS=45
# PROFILE_ASSET_SYNTHESIZER_MODEL=qwen3:8b
# PROFILE_DOCUMENT_MAPPER_MODEL=qwen3:8b
# PROFILE_EVIDENCE_UNIT_MODEL=qwen3:8b
# STRUCTURED_ASSET_SYNTH_MODEL=qwen3:8b
# STRUCTURED_EVIDENCE_UNIT_MODEL=qwen3:8b
# PROFILE_ASSET_AUDITOR_MODEL=deepseek-r1:14b
# PROFILE_EMBED_MODEL=nomic-embed-text
# LOCAL_LLM_MODEL=llama3.2:3b
PROFILE_EMBED_DIM=768


# ---------------------------------------------------------
# 5. OpenClaw (browser automation runtime -- separate install, see
#    docs/openclaw.md and scripts/openclaw_bootstrap.py)
# ---------------------------------------------------------
# Used by scripts that shell out to the `openclaw` CLI directly.
# Leave empty to prefer JobOS's pinned private runtime; set only an explicit
# absolute path when intentionally overriding it.
OPENCLAW_BIN=
# Base URL of the OpenClaw gateway once it's running (native or Docker).
OPENCLAW_BASE_URL=http://127.0.0.1:18789
# Named agent profiles OpenClaw should use for each task (must exist in
# your ~/.openclaw config -- see bootstrap/openclaw/openclaw.template.json).
OPENCLAW_AGENT_RESEARCH=main
OPENCLAW_AGENT_BROWSE=main
OPENCLAW_AGENT_LINKEDIN_DISCOVERY=linkedin_discovery
OPENCLAW_AGENT_RESUME=resume
OPENCLAW_AGENT_COVER=cover_letter
# LinkedIn supports three explicit intake paths. Keep agent discovery enabled
# only for a manually logged-in, dedicated JobOS browser profile.
JOBOS_LINKEDIN_AGENT_DISCOVERY_ENABLED=true
JOBOS_LINKEDIN_MANUAL_INTAKE_ENABLED=true
JOBOS_LINKEDIN_READONLY_CAPTURE_ENABLED=true
# Retain an absent ATS posting as stale for this many days before marking it
# closed. Historical JD evidence remains stored either way.
JOBOS_STALE_CLOSE_DAYS=14
# OpenClaw model policy. Any value may name either local Ollama
# (ollama/qwen3:8b) or an authenticated API provider (openrouter/auto,
# deepseek/deepseek-v4-flash, openai/<available-model>, etc.).
# The defaults retain the existing behavior; set all agent-specific entries
# below to your local model if you want a fully local OpenClaw workflow.
OPENCLAW_MODEL_PRIMARY=openai/gpt-5.4-mini
OPENCLAW_MODEL_FALLBACK=openrouter/free
OPENCLAW_RESUME_MODEL=openrouter/auto
OPENCLAW_COVER_MODEL=openrouter/auto
OPENCLAW_REPO_COORDINATOR_MODEL=openrouter/auto
OPENCLAW_LINKEDIN_DISCOVERY_MODEL=openrouter/auto
OPENCLAW_HOOKS_MODEL=openrouter/auto
OPENCLAW_GMAIL_MODEL=openrouter/auto

# Optional provider keys for OpenClaw itself. When present, the non-interactive
# setup script copies only these values to the private runtime
# data/openclaw-runtime/.openclaw/.env (or ~/.openclaw/.env for native mode).
# Never put these values in the tracked template or a workspace file.
# DEEPSEEK_API_KEY=CHANGE_ME_deepseek_key
# OPENAI_API_KEY=CHANGE_ME_openai_key
# OPENROUTER_API_KEY=CHANGE_ME_openrouter_key

# --- Only needed if you use the Docker fallback
#     (docker compose -f docker-compose.yml -f docker-compose.openclaw.yml up -d) ---
# Any random string -- this becomes the token you paste into the OpenClaw
# gateway UI at http://127.0.0.1:18789 the first time you open it.
OPENCLAW_GATEWAY_TOKEN=CHANGE_ME_random_token
# The setup script chooses this automatically: loopback for native mode and
# http://browser:9222 for Docker mode. Override only for a custom CDP sidecar.
# OPENCLAW_BROWSER_CDP_URL=http://127.0.0.1:9222
# Not read by docker-compose.openclaw.yml as of 2026-08-01 -- the browser
# service now runs headless Chrome directly (bypassing kasmweb/chrome's
# own noVNC startup script, which doesn't expose --remote-debugging-port
# through to Chrome), so there is no noVNC desktop to log into by hand
# anymore. Left here, unused, in case you restore the noVNC-based
# workflow later. See docker-compose.openclaw.yml's `browser` service
# comment and docs/openclaw.md for the tradeoff.
# BROWSER_VNC_PASSWORD=CHANGE_ME_random_password
# Optional Docker fallback image. Keep the tag pinned; native managed OpenClaw remains preferred.
# Required only for docker-compose.openclaw.yml; use an immutable tag@sha256 reference.
OPENCLAW_IMAGE=khal3d/openclaw:2026.2.12@sha256:cdcf12dc0ab3c97518c47a9a205d3fbe65b4b65a787bc5900172c9a462fc3bda

# Resume PDF export uses a fixed PDF overlay and is deliberately off until the
# one-page visual calibration has passed on this machine. Do not enable merely
# because a DOCX was generated.
# JOBOS_RESUME_TEMPLATE_OVERLAY_ENABLED=false
# JOBOS_RESUME_ARIAL_TTF=/usr/share/fonts/truetype/msttcorefonts/Arial.ttf


# ---------------------------------------------------------
# 6. OpenClaw secrets (NOT read from this .env file -- OpenClaw reads its
#    own secrets file instead: bootstrap/openclaw/secrets.local.json,
#    created by copying bootstrap/openclaw/secrets.example.json).
#    Listed here so you know every key OpenClaw itself needs before you
#    run `python scripts/openclaw_bootstrap.py bootstrap`.
# ---------------------------------------------------------
#   GATEWAY_TOKEN            -- same random token as OPENCLAW_GATEWAY_TOKEN above
#   HOOKS_TOKEN               -- random token, protects OpenClaw's webhook endpoint
#   TELEGRAM_BOT_TOKEN        -- from @BotFather on Telegram, if you want Telegram control
#   TELEGRAM_ALLOW_FROM       -- your Telegram numeric user ID(s), as a JSON array
#   GMAIL_ACCOUNT              -- Gmail address OpenClaw should watch, if using Gmail push
#   GMAIL_TOPIC                -- Google Cloud Pub/Sub topic (Gmail watch integration)
#   GMAIL_SUBSCRIPTION         -- Google Cloud Pub/Sub subscription name
#   GMAIL_PUSH_TOKEN           -- verification token for the Gmail push webhook
#   GOOGLE_WEBSEARCH_API_KEY   -- Google Custom Search / Programmable Search API key,
#                                 if OpenClaw's research agent uses live web search
#
# None of these are required to run the core pipeline (job intake, fit
# scoring, document generation, autofill draft) -- only needed if you turn
# on OpenClaw's Telegram control channel, Gmail watch, or web search tool.


# ---------------------------------------------------------
# 7. Tuning knobs (all optional -- sane defaults already in code)
# ---------------------------------------------------------
# JOBOS_BROWSER_LEASE_SECONDS=600
# JOBOS_BROWSER_PROFILE=remote
# JOBOS_FACT_EXTRACT_LIMIT=
# JOBOS_FACT_MIN_TOKENS=
# JOBOS_FACT_SLEEP_SECONDS=
# JOBOS_RESEARCH_TTL_DAYS=
# JOBOS_PROJECT_ROOT=
# JOBOS_PROFILE_RAW_DIR=
# JOBOS_PROFILE_PARSED_DIR=
# JOBOS_PROFILE_OCR_DIR=
# L7 -- AUTOFILL & CAPTCHA BYPASS
CAPSOLVER_API_KEY=your_capsolver_key_here
CAPSOLVER_REQUEST_TIMEOUT_SECONDS=10
CAPSOLVER_SOLVE_TIMEOUT_SECONDS=120
CAPSOLVER_POLL_INTERVAL_SECONDS=3

# --- Human Review Hub + Saved Jobs + Telegram remote review ---
JOBOS_LINKEDIN_SAVED_DISCOVERY_ENABLED=true
JOBOS_REVIEW_AUTO_RENDER_PDFS=true
JOBOS_REVIEW_ARTIFACT_DIR=./data/review-artifacts
# Telegram review is opt-in. Files sent here leave the local Ubuntu host.
JOBOS_TELEGRAM_BOT_TOKEN=
JOBOS_TELEGRAM_ALLOWED_USER_ID=
JOBOS_TELEGRAM_CHAT_ID=

# JobOS Human Approval Bus / employer account auth
# Keep the vault master key local; `python scripts/jobos.py vault init` creates a 0600 key file.
JOBOS_VAULT_KEY_FILE=data/secrets/jobos-vault.key
# Optional base64 32-byte key for service managers; if set it overrides JOBOS_VAULT_KEY_FILE.
JOBOS_VAULT_MASTER_KEY=
# OpenClaw/gog Google API reader used for bounded employer email verification.
JOBOS_GOG_BIN=gog
JOBOS_GMAIL_ACCOUNT=
# The watcher always runs gog in --readonly + --gmail-no-send + --no-input mode.
JOBOS_GMAIL_VERIFY_MAX_RESULTS=10
# Additive OpenClaw Gmail Pub/Sub wake bridge. The setup script creates the token
# automatically when a Gmail account is configured; raw email content is not forwarded.
JOBOS_GMAIL_WAKE_URL=http://127.0.0.1:8791/gmail
JOBOS_GMAIL_WAKE_TOKEN=

# JobOS bounded recovery/browser helper settings
JOBOS_MAGIC_LINK_TRUST_TTL_MINUTES=30
JOBOS_EMPLOYER_TRUST_TTL_MINUTES=1440
JOBOS_POINTER_REGIMES_PATH=data/pointer-regimes.json

# Daily runtime supervisor. Postgres autostarts through docker when available.
JOBOS_RUNTIME_START_POSTGRES=1
# Leave off if you manage OpenClaw/browser separately; set 1 for one-command browser infra startup.
JOBOS_RUNTIME_START_OPENCLAW=0
