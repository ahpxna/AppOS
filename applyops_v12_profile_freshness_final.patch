+TECH_CONFLICT_FAMILIES: dict[str, set[str]] = {
+    "python_web_framework": {"fastapi", "flask", "django"},
+    "browser_automation": {"playwright", "selenium", "puppeteer"},
+    "javascript_web_framework": {"express", "nextjs", "next_js"},
