+def sql(version: int) -> str:
+    matches = sorted(MIGRATIONS.glob(f"{version:03d}_*.sql"))
+    assert len(matches) == 1, f"expected exactly one migration {version:03d}, got {matches}"
+    return matches[0].read_text(encoding="utf-8")
