+        cwd=Path(__file__).resolve().parents[2], capture_output=True, text=True, timeout=600,
+    )
+    detail = ((proc.stdout or "") + (proc.stderr or "")).strip()[-4000:]
+    return proc.returncode == 0, detail
+
